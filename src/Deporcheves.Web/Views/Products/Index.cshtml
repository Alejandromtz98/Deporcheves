@model IEnumerable<Deporcheves.Domain.Entities.Product>
@{ ViewData["Title"] = "Productos"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Productos</h1>
    <a asp-action="Create" class="btn btn-primary">Nuevo producto</a>
</div>

<!-- Formulario de Búsqueda -->
<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group" style="max-width: 400px;">
        <input type="text" name="search" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Buscar por nombre o SKU..." />
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
        <a asp-action="Index" class="btn btn-outline-danger">Limpiar</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParm"]" asp-route-search="@ViewData["CurrentFilter"]" class="text-dark text-decoration-none">
                    Nombre @(ViewData["CurrentSort"]?.ToString() == "name_desc" ? "▼" : "▲")
                </a>
            </th>
            <th>SKU</th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["PriceSortParm"]" asp-route-search="@ViewData["CurrentFilter"]" class="text-dark text-decoration-none">
                    Precio @(ViewData["CurrentSort"]?.ToString() == "price_desc" ? "▼" : (ViewData["CurrentSort"]?.ToString() == "price" ? "▲" : ""))
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["StockSortParm"]" asp-route-search="@ViewData["CurrentFilter"]" class="text-dark text-decoration-none">
                    Stock @(ViewData["CurrentSort"]?.ToString() == "stock_desc" ? "▼" : (ViewData["CurrentSort"]?.ToString() == "stock" ? "▲" : ""))
                </a>
            </th>
            <th>Stock Mínimo</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr class="@(product.IsBelowMinimumStock() ? "table-warning" : "")">
                <td>@product.Name</td>
                <td>@product.Sku</td>
                <td>@product.Price.ToString("C")</td>
                <td>@product.Stock</td>
                <td>@product.MinimumStock</td>
                <td>@(product.IsActive ? "Activo" : "Inactivo")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                </td>
            </tr>
        }
    </tbody>
</table>