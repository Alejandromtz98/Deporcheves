@model IEnumerable<Deporcheves.Domain.Entities.Product>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>SKU</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Stock Mínimo</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="7" class="text-center text-muted">No se encontraron productos.</td></tr>
        }
        @foreach (var product in Model)
        {
            <tr class="@(product.IsBelowMinimumStock() ? "table-warning" : "")">
                <td>@product.Name</td>
                <td>@product.Sku</td>
                <td>@product.Price.ToString("C")</td>
                <td>@product.Stock</td>
                <td>@product.MinimumStock</td>
                <td>@(product.IsActive ? "Activo" : "Inactivo")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                </td>
            </tr>
        }
    </tbody>
</table>