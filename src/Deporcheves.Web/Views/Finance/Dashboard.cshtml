@model Deporcheves.Application.Dtos.Finance.FinancialDashboardDto
@{ ViewData["Title"] = "Dashboard Financiero"; }

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="mb-1">Dashboard Financiero</h2>
        <div class="btn-group btn-group-sm">
            <a asp-action="Dashboard" asp-route-startDate="@ViewData["StartDate"]" class="btn btn-outline-secondary active">Periodo Seleccionado</a>
        </div>
    </div>
    
    <div class="d-flex gap-2 align-items-center flex-wrap">
        <a asp-action="FixedCosts" class="btn btn-outline-primary btn-sm">Gestionar Costos Fijos</a>
        <a asp-action="ExportCsv" asp-route-startDate="@ViewData["StartDate"]" asp-route-endDate="@ViewData["EndDate"]" class="btn btn-success btn-sm">Exportar CSV</a>
        
        <form method="get" class="d-flex gap-2 align-items-center bg-light p-2 rounded shadow-sm mb-0">
            <label class="fw-bold mb-0 text-nowrap small">Desde:</label>
            <input type="date" name="startDate" value="@ViewData["StartDate"]" class="form-control form-control-sm" />
            <label class="fw-bold mb-0 text-nowrap small">Hasta:</label>
            <input type="date" name="endDate" value="@ViewData["EndDate"]" class="form-control form-control-sm" />
            <button type="submit" class="btn btn-primary btn-sm">Filtrar</button>
        </form>
    </div>
</div>

<!-- FILA 1: Indicadores Principales -->
<div class="row mb-3">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-success text-white h-100">
            <div class="card-body">
                <h6 class="text-uppercase mb-2 small">Utilidad Neta (Contable)</h6>
                <h3 class="mb-0">@Model.NetProfit.ToString("C")</h3>
                <small>Margen: @Model.GrossMarginPercentage.ToString("N1")%</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-primary text-white h-100">
            <div class="card-body">
                <h6 class="text-uppercase mb-2 small">Flujo de Caja Real</h6>
                <h3 class="mb-0">@Model.RealCashFlow.ToString("C")</h3>
                <small>Efectivo neto generado</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-warning text-dark h-100">
            <div class="card-body">
                <h6 class="text-uppercase mb-2 small">Retiro Seguro Sugerido</h6>
                <h3 class="mb-0">@Model.SafeWithdrawal.ToString("C")</h3>
                <small>Libre de deudas e inventario</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-info text-white h-100">
            <div class="card-body">
                <h6 class="text-uppercase mb-2 small">Valor del Inventario</h6>
                <h3 class="mb-0">@Model.InventoryValue.ToString("C")</h3>
                <small>Capital atrapado en stock</small>
            </div>
        </div>
    </div>
</div>

<!-- FILA 2: Deudas y Equilibrio -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-secondary text-white h-100">
            <div class="card-body">
                <h6 class="text-uppercase mb-2 small">Cuentas por Cobrar</h6>
                <h3 class="mb-0">@Model.TotalReceivables.ToString("C")</h3>
                <small>Dinero fiado (Por cobrar)</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-dark text-white h-100">
            <div class="card-body">
                <h6 class="text-uppercase mb-2 small">Cuentas por Pagar</h6>
                <h3 class="mb-0">@Model.TotalPayables.ToString("C")</h3>
                <small>Deuda con proveedores</small>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm border-0 bg-light h-100">
            <div class="card-body d-flex flex-column justify-content-center">
                <h6 class="text-uppercase text-muted mb-2 small">Punto de Equilibrio (Mensual)</h6>
                <h3 class="mb-0">@Model.BreakEvenPoint.ToString("C")</h3>
                <small class="text-muted">Costos Fijos: @Model.MonthlyFixedCosts.ToString("C")</small>
            </div>
        </div>
    </div>
</div>

<!-- FILA 3: Inversión y KPIs Operativos -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-secondary text-white h-100">
            <div class="card-body">
                <h6 class="text-uppercase mb-2 small">Capital Inicial</h6>
                <h3 class="mb-0">@Model.InitialCapital.ToString("C")</h3>
                <small>Inversión total</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-dark text-white h-100">
            <div class="card-body">
                <h6 class="text-uppercase mb-2 small">Retorno (ROI)</h6>
                <h3 class="mb-0">@Model.ReturnOnInvestment.ToString("N1")%</h3>
                <small>Recuperación de inversión</small>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm border-0 bg-light h-100">
            <div class="card-body">
                <div class="row text-center h-100 align-items-center">
                    <div class="col-4 border-end">
                        <h6 class="text-muted small mb-1">Operaciones</h6>
                        <h4 class="mb-0">@Model.TotalOperations</h4>
                    </div>
                    <div class="col-4 border-end">
                        <h6 class="text-muted small mb-1">Ticket Promedio</h6>
                        <h4 class="mb-0">@Model.AverageTicket.ToString("C")</h4>
                    </div>
                    <div class="col-4">
                        <h6 class="text-muted small mb-1">Unidades Vendidas</h6>
                        <h4 class="mb-0">@Model.TotalUnitsSold</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Alerta de productos sin costo -->
@if (Model.ProductsWithoutCost > 0)
{
    <div class="alert alert-warning shadow-sm">
        <strong>⚠️ Alerta de Fiabilidad:</strong> Hay @Model.ProductsWithoutCost producto(s) activos sin costo registrado. La utilidad mostrada podría no ser exacta hasta que actualices sus costos.
    </div>
}

<div class="row">
    <!-- Gráfico -->
    <div class="col-md-8 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-dark text-white">
                Flujo Financiero del Periodo
            </div>
            <div class="card-body">
                <canvas id="financialChart" style="max-height: 400px;"></canvas>
            </div>
        </div>
    </div>
    
    <!-- Estado de Resultados -->
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-secondary text-white">
                Estado de Resultados
            </div>
            <div class="card-body p-0">
                <table class="table table-striped mb-0">
                    <tbody>
                        <tr>
                            <td>Ingresos Totales</td>
                            <td class="text-end text-success fw-bold">@Model.TotalRevenue.ToString("C")</td>
                        </tr>
                        <tr>
                            <td>(-) Costo de Ventas (COGS)</td>
                            <td class="text-end text-danger">-@Model.TotalCogs.ToString("C")</td>
                        </tr>
                        <tr class="table-active fw-bold">
                            <td>= Utilidad Bruta</td>
                            <td class="text-end">@Model.GrossProfit.ToString("C")</td>
                        </tr>
                        <tr>
                            <td>(-) Gastos Operativos (OPEX)</td>
                            <td class="text-end text-danger">-@Model.TotalOpex.ToString("C")</td>
                        </tr>
                        <tr class="table-dark fw-bold">
                            <td>= Utilidad Neta</td>
                            <td class="text-end">@Model.NetProfit.ToString("C")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const ctx = document.getElementById('financialChart').getContext('2d');
            
            const revenue = @Html.Raw(Model.TotalRevenue.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture));
            const cogs = @Html.Raw(Model.TotalCogs.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture));
            const opex = @Html.Raw(Model.TotalOpex.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture));
            const netProfit = @Html.Raw(Model.NetProfit.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture));

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Ingresos', 'COGS', 'OPEX', 'Utilidad Neta'],
                    datasets: [{
                        label: 'Monto ($)',
                        data: [revenue, cogs, opex, netProfit],
                        backgroundColor: [
                            'rgba(25, 135, 84, 0.8)',
                            'rgba(220, 53, 69, 0.8)',
                            'rgba(255, 193, 7, 0.8)',
                            'rgba(13, 110, 253, 0.8)'
                        ],
                        borderColor: [
                            'rgba(25, 135, 84, 1)',
                            'rgba(220, 53, 69, 1)',
                            'rgba(255, 193, 7, 1)',
                            'rgba(13, 110, 253, 1)'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return '$' + value.toLocaleString();
                                }
                            }
                        }
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.parsed.y.toLocaleString('es-MX', { style: 'currency', currency: 'MXN' });
                                }
                            }
                        }
                    }
                }
            });
        });
    </script>
}