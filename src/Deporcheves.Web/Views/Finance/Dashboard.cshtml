@model Deporcheves.Application.Dtos.Finance.FinancialDashboardDto
@{ ViewData["Title"] = "Dashboard Financiero"; }

@{
    // Calcular fechas para atajos
    var today = DateTime.Today;
    // Asumiendo que la semana empieza en Lunes
    var diff = (7 + (today.DayOfWeek - DayOfWeek.Monday)) % 7;
    var thisWeekStart = today.AddDays(-1 * diff);
    var lastWeekStart = thisWeekStart.AddDays(-7);
    var lastWeekEnd = thisWeekStart.AddDays(-1);
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="mb-1">Dashboard Financiero</h2>
        <div class="btn-group btn-group-sm">
            <a asp-action="Dashboard" asp-route-startDate="@thisWeekStart.ToString("yyyy-MM-dd")" asp-route-endDate="@today.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">Esta Semana</a>
            <a asp-action="Dashboard" asp-route-startDate="@lastWeekStart.ToString("yyyy-MM-dd")" asp-route-endDate="@lastWeekEnd.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">Semana Pasada</a>
        </div>
    </div>
    
    <div class="d-flex gap-2 align-items-center">
        <a asp-action="FixedCosts" class="btn btn-outline-primary btn-sm">Gestionar Costos Fijos</a>
        <a asp-action="ExportCsv" asp-route-startDate="@ViewData["StartDate"]" asp-route-endDate="@ViewData["EndDate"]" class="btn btn-success btn-sm">Exportar CSV</a>
        
        <form method="get" class="d-flex gap-2 align-items-center bg-light p-2 rounded shadow-sm mb-0">
            <label class="fw-bold mb-0 text-nowrap">Desde:</label>
            <input type="date" name="startDate" value="@ViewData["StartDate"]" class="form-control form-control-sm" />
            <label class="fw-bold mb-0 text-nowrap">Hasta:</label>
            <input type="date" name="endDate" value="@ViewData["EndDate"]" class="form-control form-control-sm" />
            <button type="submit" class="btn btn-primary btn-sm">Filtrar</button>
        </form>
    </div>
</div>

<!-- Tarjetas de KPIs Principales -->
<!-- Fila 1: Resultados Operativos -->
<div class="row mb-3">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-success text-white h-100">
            <div class="card-body">
                <h6 class="text-uppercase mb-2">Utilidad Neta (Contable)</h6>
                <h2 class="mb-0">@Model.NetProfit.ToString("C")</h2>
                <small>Margen: @Model.GrossMarginPercentage.ToString("N1")%</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-primary text-white h-100">
            <div class="card-body">
                <h6 class="text-uppercase mb-2">Flujo de Caja Real</h6>
                <h2 class="mb-0">@Model.RealCashFlow.ToString("C")</h2>
                <small>Efectivo neto generado</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-warning text-dark h-100">
            <div class="card-body">
                <h6 class="text-uppercase mb-2">Retiro Seguro Sugerido</h6>
                <h2 class="mb-0">@Model.SafeWithdrawal.ToString("C")</h2>
                <small>Libre de deudas e inventario</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-info text-white h-100">
            <div class="card-body">
                <h6 class="text-uppercase mb-2">Valor del Inventario</h6>
                <h2 class="mb-0">@Model.InventoryValue.ToString("C")</h2>
                <small>Capital atrapado en stock</small>
            </div>
        </div>
    </div>
</div>

<!-- Fila 2: Deudas -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-secondary text-white h-100">
            <div class="card-body">
                <h6 class="text-uppercase mb-2">Cuentas por Cobrar</h6>
                <h2 class="mb-0">@Model.TotalReceivables.ToString("C")</h2>
                <small>Dinero fiado (Por cobrar)</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-dark text-white h-100">
            <div class="card-body">
                <h6 class="text-uppercase mb-2">Cuentas por Pagar</h6>
                <h2 class="mb-0">@Model.TotalPayables.ToString("C")</h2>
                <small>Deuda con proveedores</small>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm border-0 bg-light h-100">
            <div class="card-body d-flex flex-column justify-content-center">
                <h6 class="text-uppercase text-muted mb-2">Punto de Equilibrio (Mensual)</h6>
                <h3 class="mb-0">@Model.BreakEvenPoint.ToString("C")</h3>
                <small class="text-muted">Costos Fijos: @Model.MonthlyFixedCosts.ToString("C")</small>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Gráfico de Ingresos vs Costos -->
    <div class="col-md-8">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-dark text-white">
                Flujo Financiero del Periodo
            </div>
            <div class="card-body">
                <canvas id="financialChart" style="max-height: 400px;"></canvas>
            </div>
        </div>
    </div>
    
    <!-- Desglose en Tabla -->
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-secondary text-white">
                Estado de Resultados
            </div>
            <div class="card-body p-0">
                <table class="table table-striped mb-0">
                    <tbody>
                        <tr>
                            <td>Ingresos Totales</td>
                            <td class="text-end text-success fw-bold">@Model.TotalRevenue.ToString("C")</td>
                        </tr>
                        <tr>
                            <td>(-) Costo de Ventas (COGS)</td>
                            <td class="text-end text-danger">-@Model.TotalCogs.ToString("C")</td>
                        </tr>
                        <tr class="table-active fw-bold">
                            <td>= Utilidad Bruta</td>
                            <td class="text-end">@Model.GrossProfit.ToString("C")</td>
                        </tr>
                        <tr>
                            <td>(-) Gastos Operativos (OPEX)</td>
                            <td class="text-end text-danger">-@Model.TotalOpex.ToString("C")</td>
                        </tr>
                        <tr class="table-dark fw-bold">
                            <td>= Utilidad Neta</td>
                            <td class="text-end">@Model.NetProfit.ToString("C")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Cargar Chart.js desde CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const ctx = document.getElementById('financialChart').getContext('2d');
            
            // Datos inyectados desde Razor
            const revenue = @Html.Raw(Model.TotalRevenue.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture));
            const cogs = @Html.Raw(Model.TotalCogs.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture));
            const opex = @Html.Raw(Model.TotalOpex.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture));
            const netProfit = @Html.Raw(Model.NetProfit.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture));

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Ingresos', 'COGS', 'OPEX', 'Utilidad Neta'],
                    datasets: [{
                        label: 'Monto ($)',
                        data: [revenue, cogs, opex, netProfit],
                        backgroundColor: [
                            'rgba(25, 135, 84, 0.8)',  // Verde (Ingresos)
                            'rgba(220, 53, 69, 0.8)',  // Rojo (COGS)
                            'rgba(255, 193, 7, 0.8)',  // Amarillo (OPEX)
                            'rgba(13, 110, 253, 0.8)'  // Azul (Utilidad)
                        ],
                        borderColor: [
                            'rgba(25, 135, 84, 1)',
                            'rgba(220, 53, 69, 1)',
                            'rgba(255, 193, 7, 1)',
                            'rgba(13, 110, 253, 1)'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return '$' + value.toLocaleString();
                                }
                            }
                        }
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.parsed.y.toLocaleString('es-MX', { style: 'currency', currency: 'MXN' });
                                }
                            }
                        }
                    }
                }
            });
        });
    </script>
}