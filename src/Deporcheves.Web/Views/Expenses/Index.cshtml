@model IReadOnlyList<Deporcheves.Domain.Entities.Expense>
@{ ViewData["Title"] = "Gastos Operativos"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Gastos Operativos (Bancos / Transferencias)</h2>
</div>
<p class="text-muted">Usa este módulo para Renta, Luz, Agua, Internet y Nómina. Si pagas en efectivo de la caja, regístralo en la pestaña "Caja".</p>

<div class="row">
    <!-- Formulario de Registro (Izquierda) -->
    <div class="col-lg-4 col-md-12 mb-4">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">Registrar Gasto / Pago</div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="mb-2">
                        <label class="form-label">Fecha</label>
                        <input type="date" name="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" required />
                    </div>
                    
                    <div class="mb-2">
                        <label class="form-label">Categoría</label>
                        <select name="category" id="categorySelect" class="form-select" required>
                            <option value="RENTA">RENTA</option>
                            <option value="ELECTRICIDAD">ELECTRICIDAD</option>
                            <option value="AGUA">AGUA</option>
                            <option value="INTERNET">INTERNET</option>
                            <option value="NÓMINA">NÓMINA</option>
                            <option value="OTROS">OTROS</option>
                        </select>
                    </div>

                    <div class="mb-2" id="employeeDiv" style="display: none;">
                        <label class="form-label text-primary fw-bold">Seleccionar Empleado</label>
                        <select name="employeeId" id="employeeSelect" class="form-select">
                            <option value="">-- Selecciona --</option>
                            @if (ViewBag.Employees != null)
                            {
                                foreach (var emp in ViewBag.Employees as List<Deporcheves.Domain.Entities.Employee>)
                                {
                                    <option value="@emp.Id">@emp.Name (Sueldo: @emp.BaseWeeklySalary.ToString("C"))</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Descripción</label>
                        <input type="text" name="description" id="descInput" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Monto</label>
                        <input type="number" name="amount" step="0.01" min="0.01" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Forma de Pago</label>
                        <select name="paymentMethod" class="form-select">
                            <option value="Transferencia">Transferencia</option>
                            <option value="Tarjeta">Tarjeta</option>
                            <option value="Capital (Efectivo Externo)">Capital (Efectivo Externo)</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-success w-100">Guardar Gasto</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Historial de Gastos (Derecha) -->
    <div class="col-lg-8 col-md-12">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">Historial de Gastos (Últimos 100)</div>
            <div class="card-body p-0">
                @if (!Model.Any())
                {
                    <p class="text-muted p-3 mb-0">No hay gastos registrados.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Categoría</th>
                                    <th>Descripción</th>
                                    <th>Método</th>
                                    <th class="text-end">Monto</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in Model)
                                {
                                    <tr>
                                        <td>@e.Date.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                        <td>
                                            @if(e.Category == "NÓMINA") { <span class="badge bg-info">NÓMINA</span> }
                                            else { @e.Category }
                                        </td>
                                        <td>@e.Description</td>
                                        <td>@e.PaymentMethod</td>
                                        <td class="text-danger fw-bold text-end">@e.Amount.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('categorySelect').addEventListener('change', function () {
            var employeeDiv = document.getElementById('employeeDiv');
            var employeeSelect = document.getElementById('employeeSelect');
            var descInput = document.getElementById('descInput');
            
            if (this.value === 'NÓMINA') {
                employeeDiv.style.display = 'block';
                employeeSelect.required = true;
                descInput.value = "Pago de Nómina Semanal";
                descInput.readOnly = true;
            } else {
                employeeDiv.style.display = 'none';
                employeeSelect.required = false;
                employeeSelect.value = "";
                descInput.value = "";
                descInput.readOnly = false;
            }
        });
    </script>
}