@model Deporcheves.Web.Models.PurchaseFormViewModel
@{ ViewData["Title"] = "Nueva compra"; }

<h1>Nueva compra</h1>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="row">
    <div class="col-md-7">
        <h5>Agregar producto</h5>
        <form asp-action="AddItem" method="post" class="row g-2 mb-3">
            <div class="col-md-5">
                <select name="productId" class="form-select" required>
                    <option value="">Producto...</option>
                    @foreach (var p in Model.Products)
                    {
                        <option value="@p.Id">@p.Name (@p.Sku)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <input type="number" name="quantity" value="1" min="1" class="form-control" placeholder="Cant." required />
            </div>
            <div class="col-md-3">
                <input type="number" name="unitCost" step="0.01" min="0" class="form-control" placeholder="Costo unit." required />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">Agregar</button>
            </div>
        </form>
    </div>

    <div class="col-md-5">
        <h5>Items de la compra</h5>
        @if (Model.Cart.Count == 0) { <p class="text-muted">Sin items.</p> }
        else
        {
            <table class="table table-sm">
                <thead><tr><th>Producto</th><th>Cant.</th><th>Costo</th><th>Subtotal</th><th></th></tr></thead>
                <tbody>
                @foreach (var item in Model.Cart)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td>@item.Quantity</td>
                        <td>@item.UnitCost.ToString("C")</td>
                        <td>@item.Subtotal.ToString("C")</td>
                        <td>
                            <form asp-action="RemoveItem" method="post">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">X</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
                <tfoot>
                    <tr><th colspan="3" class="text-end">Total:</th><th>@Model.CartTotal.ToString("C")</th><th></th></tr>
                </tfoot>
            </table>

            <form asp-action="Confirm" method="post">
                <div class="mb-3">
                    <label class="form-label">Proveedor</label>
                    <select name="supplierId" class="form-select" required>
                        <option value="">Selecciona un proveedor...</option>
                        @foreach (var s in Model.Suppliers)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>
                <button type="submit" class="btn btn-success w-100" onclick="return confirm('Confirmar compra?');">
                    Confirmar compra
                </button>
            </form>
        }
    </div>
</div>