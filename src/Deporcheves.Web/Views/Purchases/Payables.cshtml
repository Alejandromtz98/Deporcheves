@model IReadOnlyList<Deporcheves.Application.Dtos.Purchases.PurchaseDto>
@{ ViewData["Title"] = "Cuentas por Pagar"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Cuentas por Pagar (Proveedores)</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">Volver a Compras</a>
</div>

@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }

@if (!Model.Any())
{
    <div class="alert alert-info">No hay compras con saldo pendiente. Todo está pagado.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Folio</th>
                <th>Proveedor</th>
                <th>Total</th>
                <th>Pagado</th>
                <th>Saldo</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
                    <td>@p.PurchaseNumber</td>
                    <td>@p.SupplierName</td>
                    <td>@p.Total.ToString("C")</td>
                    <td>@p.PaidAmount.ToString("C")</td>
                    <td class="text-danger fw-bold">@p.Balance.ToString("C")</td>
                    <td>
                        <form asp-action="Pay" method="post" class="d-flex gap-1">
                            <input type="hidden" name="id" value="@p.Id" />
                            <input type="number" name="amount" step="0.01" min="0.01" max="@p.Balance" value="@p.Balance" class="form-control form-control-sm" style="width: 100px;" required />
                            <button type="submit" class="btn btn-sm btn-primary">Abonar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}