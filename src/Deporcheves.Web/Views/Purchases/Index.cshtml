@model IReadOnlyList<Deporcheves.Application.Dtos.Purchases.PurchaseDto>
@{ ViewData["Title"] = "Compras del dia"; }

<div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Compras</h2>
        <div class="d-flex gap-2 align-items-center">
            <form method="get" class="d-flex gap-2 align-items-center mb-0">
                <label class="fw-bold mb-0">Desde:</label>
                <input type="date" name="startDate" value="@ViewData["StartDate"]" class="form-control form-control-sm" />
                <label class="fw-bold mb-0">Hasta:</label>
                <input type="date" name="endDate" value="@ViewData["EndDate"]" class="form-control form-control-sm" />
                <button type="submit" class="btn btn-primary btn-sm">Filtrar</button>
            </form>
            <a asp-action="Create" class="btn btn-success btn-sm">Nueva compra</a>
        </div>
    </div>
    
<h1>Compras del dia</h1>
<p><a asp-action="Create" class="btn btn-primary">Nueva compra</a></p>

@if (Model.Count == 0) { <p class="text-muted">No hay compras registradas hoy.</p> }
else
{
    <table class="table table-striped">
        <thead><tr><th>Numero</th><th>Hora</th><th>Proveedor</th><th>Total</th><th></th></tr></thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.PurchaseNumber</td>
                <td>@p.CreatedAt.ToLocalTime().ToString("HH:mm")</td>
                <td>@p.SupplierName</td>
                <td>@p.Total.ToString("C")</td>
                <td><a asp-action="Details" asp-route-id="@p.Id">Detalle</a></td>
                <td>
                @if(@p.IsFullyPaid)
                {
                    <span class= "badge bg-success">Pagada</span>
                }
                else
                {
                    <span class="badge bg-danger" title="Saldo pendiente: @p.Balance.ToString("C")">Pendiente</span>
                }
                </td>
            </tr>
        }
        </tbody>
    </table>
    <p><strong>Total del dia:</strong> @Model.Sum(p => p.Total).ToString("C")</p>
}