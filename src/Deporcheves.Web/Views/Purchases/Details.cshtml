@model Deporcheves.Application.Dtos.Purchases.PurchaseDto
@{ ViewData["Title"] = $"Compra {Model.PurchaseNumber}"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Compra @Model.PurchaseNumber</h1>
    @if (Model.IsFullyPaid)
    {
        <span class="badge bg-success fs-5">Pagada Completamente</span>
    }
    else
    {
        <span class="badge bg-danger fs-5">Saldo Pendiente</span>
    }
</div>

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <p class="mb-1"><strong>Proveedor:</strong> @Model.SupplierName</p>
        <p class="mb-1"><strong>Fecha:</strong> @Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</p>
        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <p class="mb-0"><strong>Notas:</strong> @Model.Notes</p>
        }
    </div>
</div>

<table class="table table-striped">
    <thead class="table-dark">
        <tr><th>Producto</th><th>Cantidad</th><th>Costo Unitario</th><th>Subtotal</th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Items)
    {
        <tr>
            <td>@item.ProductName</td>
            <td>@item.Quantity</td>
            <td>@item.UnitCost.ToString("C")</td>
            <td>@item.Subtotal.ToString("C")</td>
        </tr>
    }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3" class="text-end">Total de la compra:</th>
            <th>@Model.Total.ToString("C")</th>
        </tr>
        <tr>
            <td colspan="3" class="text-end text-success">Importe Pagado:</td>
            <td class="text-success">@Model.PaidAmount.ToString("C")</td>
        </tr>
        <tr>
            <td colspan="3" class="text-end @(Model.IsFullyPaid ? "text-muted" : "text-danger fw-bold")">Saldo Pendiente:</td>
            <td class="@(Model.IsFullyPaid ? "text-muted" : "text-danger fw-bold")">@Model.Balance.ToString("C")</td>
        </tr>
    </tfoot>
</table>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
</div>